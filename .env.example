# =====================================================================
# New Smart CV — variables d'environnement (MODÈLE)
# ---------------------------------------------------------------------
# Copie ce fichier en `.env` puis renseigne les vraies valeurs.
# `.env` est ignoré par git : ne commit JAMAIS de secrets.
# En Phase 0, seules les sections APPLICATION et BASE DE DONNÉES sont
# réellement utilisées ; le reste est déclaré à l'avance pour les phases
# suivantes (pour ne rien oublier).
# =====================================================================

# ---- Application ----
APP_ENV=local                 # local | staging | production
APP_NAME=New Smart CV
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
API_PORT=8000

# ---- Base de données (PostgreSQL + pgvector) ----
POSTGRES_USER=nscv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nscv
POSTGRES_HOST=postgres        # nom du service docker-compose (localhost si l'API tourne hors Docker)
POSTGRES_PORT=5432
# URL async utilisée par SQLAlchemy (driver asyncpg), dérivée des valeurs ci-dessus
DATABASE_URL=postgresql+asyncpg://nscv:change-me@postgres:5432/nscv

# ---- Authentification JWT (Phase 1) ----
JWT_SECRET_KEY=change-me-utiliser-une-longue-chaine-aleatoire
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- File de jobs / cache (Redis — Phase 2/3) ----
REDIS_URL=redis://redis:6379/0

# ---- Stockage fichiers (MinIO / S3 — Phase 1) ----
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cv-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# ---- Fournisseurs LLM (offres gratuites — Phase 2) ----
LLM_PROVIDER_ORDER=groq,gemini,hf     # ordre de la cascade
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---- Embeddings locaux (Phase 2) ----
EMBEDDINGS_MODEL=intfloat/multilingual-e5-base

# ---- OCR (Phase 2) ----
TESSERACT_LANG=fra+eng
OCR_DPI=300

# ---- Google Drive (Phase 3) ----
# Fournir le JSON du service account via un secret (PAS de fichier commité).
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_FOLDER_IDS=              # IDs de dossiers séparés par des virgules

# ---- Frontend (Next.js) ----
WEB_PORT=3000                          # port hôte du front (changer si 3000 est déjà pris)
NEXT_PUBLIC_API_URL=http://localhost:8000
